generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== TRANSACCIONES =====
// Cada movimiento bancario (importado de Fintoc o manual)
model Transaction {
  id          String   @id @default(cuid())
  fintocId    String?  @unique // ID original de Fintoc (null si es manual)
  date        DateTime
  description String
  amount      Float    // positivo = ingreso, negativo = gasto
  currency    String   @default("CLP")
  accountId   String?
  accountName String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== CATEGORÍAS =====
// Ej: "Casa", "Colegiatura", "Carrete", "Insumos"
model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  icon         String?       // emoji o nombre de icono
  color        String?       // color hex para el dashboard
  budgetLimit  Float?        // límite de gasto mensual (opcional)
  priority     String?       // "esencial", "necesario", "prescindible", "innecesario"
  transactions Transaction[]
  fixedExpenses FixedExpense[]
  rules        CategoryRule[]
  createdAt    DateTime      @default(now())
}

// ===== REGLAS DE CATEGORIZACIÓN =====
// Mapea keywords o remitentes a categorías automáticamente
model CategoryRule {
  id          String   @id @default(cuid())
  keyword     String   // keyword o nombre del remitente
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  issender    Boolean  @default(false) // true = es regla por remitente
  createdAt   DateTime @default(now())

  @@unique([keyword, categoryId])
}

// ===== GASTOS FIJOS =====
// Ej: "Luz" el día 4 de cada mes, "Agua" el día 10
model FixedExpense {
  id          String   @id @default(cuid())
  name        String   // "Cuenta de luz", "Internet"
  amount      Float
  dayOfMonth  Int      // día del mes en que se paga (1-28)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isActive    Boolean  @default(true)
  lastPaidAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== METAS DE AHORRO =====
model SavingsGoal {
  id            String   @id @default(cuid())
  name          String   // "Vacaciones", "Fondo emergencia"
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== CONEXIÓN BANCARIA (Fintoc) =====
model BankLink {
  id          String   @id @default(cuid())
  fintocLinkId String  @unique
  bankName    String
  holderName  String?
  lastSync    DateTime?
  createdAt   DateTime @default(now())
}

// ===== CUENTAS BANCARIAS =====
model BankAccount {
  id          String   @id @default(cuid())
  fintocId    String   @unique // ID de la cuenta en Fintoc
  name        String   // "Cuenta Vista", "Cuenta Corriente"
  type        String   // "sight_account", "checking_account"
  number      String   // número de cuenta
  available   Float    @default(0)
  current     Float    @default(0)
  creditLimit Float    @default(0) // límite de crédito (0 si no tiene)
  currency    String   @default("CLP")
  updatedAt   DateTime @updatedAt
}

// ===== TARJETAS DE CRÉDITO =====
model CreditCard {
  id              String   @id @default(cuid())
  name            String   // "Visa Banco de Chile"
  lastFourDigits  String?  // "1234"
  cupoTotal       Float    // límite total ($500,000)
  deudaActual     Float    @default(0) // deuda vigente
  facturadoMes    Float    @default(0) // facturado del mes actual
  pagadoMes       Float    @default(0) // pagado este mes
  billingCloseDay Int      @default(26) // día de cierre de facturación
  isTitular       Boolean  @default(true) // true = titular, false = adicional
  fintocId        String?  @unique // ID de Fintoc (si viene de ahí)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// ===== TRICOUNT / SPLIT DE GASTOS =====
model SplitGroup {
  id        String       @id @default(cuid())
  name      String       // "Asado viernes", "Vacaciones"
  members   SplitMember[]
  expenses  SplitExpense[]
  createdAt DateTime     @default(now())
}

model SplitMember {
  id       String        @id @default(cuid())
  name     String
  groupId  String
  group    SplitGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payments SplitExpense[] @relation("PaidBy")
  shares   SplitShare[]
}

model SplitExpense {
  id          String       @id @default(cuid())
  description String
  amount      Float
  paidById    String
  paidBy      SplitMember  @relation("PaidBy", fields: [paidById], references: [id])
  groupId     String
  group       SplitGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  shares      SplitShare[]
  createdAt   DateTime     @default(now())
}

model SplitShare {
  id        String       @id @default(cuid())
  memberId  String
  member    SplitMember  @relation(fields: [memberId], references: [id])
  expenseId String
  expense   SplitExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount    Float        // cuánto le corresponde pagar a esta persona
}
